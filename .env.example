# Optional. Enables LLM scene generation through the Anthropic API (server-side only).
# Without it VANTA uses its built-in heuristic scene generator.
ANTHROPIC_API_KEY=
# Alternative to ANTHROPIC_API_KEY (bearer token).
ANTHROPIC_AUTH_TOKEN=
# Optional model override (default: claude-opus-5-5, see src/server/ai/config.ts).
VANTA_AI_MODEL=
# Optional effort: low (default, fastest) | medium | high.
VANTA_AI_EFFORT=
# Server-side refusal fallbacks are on by default; set to 0 to disable.
VANTA_AI_FALLBACKS=
